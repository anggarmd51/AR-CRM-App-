# Gemini server-side AI key. Never expose this value to the browser.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

# Firebase Web App configuration for the AR CRM project.
# Development always uses local Auth/Firestore emulators; do not add a live opt-out.
# Replace placeholders locally in .env.local only; never commit real values.
VITE_FIREBASE_TARGET="local"
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="YOUR_FIREBASE_AUTH_DOMAIN"
VITE_FIREBASE_PROJECT_ID="YOUR_FIREBASE_PROJECT_ID"
VITE_FIREBASE_STORAGE_BUCKET="YOUR_FIREBASE_STORAGE_BUCKET"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_FIREBASE_MESSAGING_SENDER_ID"
VITE_FIREBASE_APP_ID="YOUR_FIREBASE_APP_ID"
VITE_FIREBASE_RECAPTCHA_ENTERPRISE_SITE_KEY=""
# Leave both empty until explicit owner verification; no first-user-wins.
VITE_FIREBASE_WORKSPACE_ID=""
# Exact Firebase Auth UID of the designated owner; leave unset to deny access.
VITE_FIREBASE_OWNER_UID=""

# Server-only Firestore -> Google Sheets export. Keep every secret out of VITE_*.
# Leave unconfigured until the service account, destination tab, and Vercel Cron are approved.
# FIRESTORE_EXPORT_PROJECT_ID="ar-crm-73222"
# FIRESTORE_EXPORT_WORKSPACE_ID="ar-crm-owner"
# FIRESTORE_EXPORT_OWNER_UID=""
# GOOGLE_SHEETS_SPREADSHEET_ID=""
# GOOGLE_SHEETS_TAB_NAME="CRM Export"
# GOOGLE_SERVICE_ACCOUNT_EMAIL=""
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""
# CRON_SECRET=""
