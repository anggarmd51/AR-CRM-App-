# Gemini server-side AI key. Never expose this value to the browser.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

# Firebase Web App configuration for the AR CRM project.
# Development always uses local Auth/Firestore emulators; do not add a live opt-out.
# Replace placeholders locally in .env.local only; never commit real values.
VITE_FIREBASE_TARGET="local"
VITE_FIREBASE_API_KEY="YOUR_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="YOUR_FIREBASE_AUTH_DOMAIN"
VITE_FIREBASE_PROJECT_ID="YOUR_FIREBASE_PROJECT_ID"
VITE_FIREBASE_STORAGE_BUCKET="YOUR_FIREBASE_STORAGE_BUCKET"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_FIREBASE_MESSAGING_SENDER_ID"
VITE_FIREBASE_APP_ID="YOUR_FIREBASE_APP_ID"
# Public web OAuth client ID matching the Firebase Google provider (not a secret).
VITE_GOOGLE_CLIENT_ID="YOUR_GOOGLE_WEB_CLIENT_ID"
VITE_FIREBASE_RECAPTCHA_ENTERPRISE_SITE_KEY=""
# Leave both empty until explicit owner verification; no first-user-wins.
VITE_FIREBASE_WORKSPACE_ID=""
# Exact Firebase Auth UID of the designated owner; leave unset to deny access.
VITE_FIREBASE_OWNER_UID=""

# Server-only Firestore -> Google Sheets export. Keep every secret out of VITE_*.
# Leave unconfigured until the service account, destination tab, and Vercel Cron are approved.
# FIRESTORE_EXPORT_PROJECT_ID="ar-crm-73222"
# FIRESTORE_EXPORT_WORKSPACE_ID="ar-crm-owner"
# FIRESTORE_EXPORT_OWNER_UID=""
# GOOGLE_SHEETS_SPREADSHEET_ID=""
# GOOGLE_SHEETS_TAB_NAME="CRM Export"
# GOOGLE_SERVICE_ACCOUNT_EMAIL=""
# GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""
# CRON_SECRET=""

# Optional Live Prospecting Engine keys: server-side only, never use VITE_* names.
# Active order is Groq -> Gemini -> OpenRouter; DeepSeek/Cohere are not used.
# Review provider account tier, pricing, free-tier eligibility, quotas, and data-use terms first.
# The Production route stays disabled unless both review flags are explicitly true.
# GROQ_API_KEY=""
# GEMINI_API_KEY=""  # The server-side Gemini key declared above may be reused.
# OPENROUTER_API_KEY=""
# Only the fixed model IDs below are accepted. Any other *_MODEL override fails closed
# before any provider request; changing a model requires a reviewed code change.
# GROQ_MODEL="openai/gpt-oss-20b"
# GEMINI_MODEL="gemini-3.8-flash"
# OPENROUTER_MODEL="openrouter/free"
# PROSPECTING_AI_ENABLED="false"
# PROSPECTING_AI_COST_AND_DATA_REVIEWED="false"
