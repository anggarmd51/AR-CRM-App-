# TEMPLATE ONLY — values must come from the separate Firebase staging Web App below.
# This file is not an active env. Copy to .env.staging.local only after completing
# Firebase Console setup; .env.staging.local is ignored by Git.
# Do not copy values from .env.local, Production, or any production binding.
# Do not add these to Vercel Preview until a separate explicit approval is given.
VITE_FIREBASE_TARGET="staging"
VITE_FIREBASE_STAGING_PROJECT_ID_ALLOWLIST=YOUR_STAGING_FIREBASE_PROJECT_ID
VITE_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=YOUR_FIREBASE_AUTH_DOMAIN
VITE_FIREBASE_PROJECT_ID=YOUR_STAGING_FIREBASE_PROJECT_ID
VITE_FIREBASE_STORAGE_BUCKET=YOUR_FIREBASE_STORAGE_BUCKET
VITE_FIREBASE_MESSAGING_SENDER_ID=YOUR_FIREBASE_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID

# Required by the fail-closed startup guard. Keep empty until a staging-only key
# is configured and the local loopback host is registered in the staging provider.
VITE_FIREBASE_RECAPTCHA_ENTERPRISE_SITE_KEY=""
VITE_AI_LEAD_FINDER_ENABLED="false"
VITE_AI_MEETING_SUMMARIZER_ENABLED="false"

# Keep both empty until the owner signs in to staging and a distinct staging
# Rules/client binding plus workspace/member bootstrap have been reviewed.
VITE_FIREBASE_WORKSPACE_ID=""
VITE_FIREBASE_OWNER_UID=""

# Local Vite development always uses emulators and rejects target=staging.
# The UID-only bootstrap route is available only in a non-development build on
# http://localhost/127.0.0.1/[::1], after staging App Check and Google Auth work.
# If creating that local preview build, use a temporary copy excluding all
# existing .env* files and .npmrc; never run a root build that can load .env.local.
# Never expose private service-account keys, tokens, or credentials through VITE_*.

# Account PIN server-only Vercel Preview variables are intentionally unset here.
# Do not copy service credentials or peppers to any VITE_* variable or client env.
# ACCOUNT_PIN_ENABLED=false
# ACCOUNT_PIN_ENROLLMENT_ENABLED=false
# FIREBASE_ADMIN_PROJECT_ID=ar-crm-staging-angga-20261027
# FIREBASE_ADMIN_SERVICE_ACCOUNT_JSON=<staging-only service account JSON>
# ACCOUNT_PIN_OWNER_UID=<designated staging owner UID>
# ACCOUNT_PIN_PEPPER=<random secret, at least 32 bytes>
# No verifier env is used: the scrypt verifier is created once in the Admin-only
# accountPinCredentials/{uid} Firestore document. There is no reset endpoint.
# Both AI features remain off by default. Only if separately approved for the existing
# protected Preview, set their server flags and GEMINI_API_KEY server-side; never VITE_*.
# AI_LEAD_FINDER_ENABLED=false
# AI_MEETING_SUMMARIZER_ENABLED=false
# GEMINI_API_KEY=<existing Preview-only sensitive secret; do not copy or print>
