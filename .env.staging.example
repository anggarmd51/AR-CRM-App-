# TEMPLATE ONLY — populate these values from a newly created, separate Firebase staging project.
# Set these as Vercel Preview environment variables; do not use production project values here.
VITE_FIREBASE_TARGET="staging"
# Public guard value: replace with the exact project ID below after provisioning.
# Only IDs matching ar-crm-staging-<suffix> are accepted by Preview builds.
VITE_FIREBASE_STAGING_PROJECT_ID_ALLOWLIST="ar-crm-staging-your-project-suffix"
VITE_FIREBASE_API_KEY="YOUR_STAGING_FIREBASE_API_KEY"
VITE_FIREBASE_AUTH_DOMAIN="YOUR_STAGING_FIREBASE_AUTH_DOMAIN"
VITE_FIREBASE_PROJECT_ID="ar-crm-staging-your-project-suffix"
VITE_FIREBASE_STORAGE_BUCKET="YOUR_STAGING_FIREBASE_STORAGE_BUCKET"
VITE_FIREBASE_MESSAGING_SENDER_ID="YOUR_STAGING_FIREBASE_MESSAGING_SENDER_ID"
VITE_FIREBASE_APP_ID="YOUR_STAGING_FIREBASE_APP_ID"

# Register a reCAPTCHA Enterprise web key for this staging Firebase app and Preview host.
# This public site key is not a secret, but it must belong to the staging app/domain.
VITE_FIREBASE_RECAPTCHA_ENTERPRISE_SITE_KEY="YOUR_STAGING_RECAPTCHA_ENTERPRISE_SITE_KEY"

# Keep empty until a staging workspace and synthetic test owner are provisioned.
VITE_FIREBASE_WORKSPACE_ID=""
VITE_FIREBASE_OWNER_UID=""

# Server-only values, if the staging feature set needs them, are configured separately
# in Vercel Preview. Never expose a credential through a VITE_* variable.
# GEMINI_API_KEY=""
# APP_URL=""
